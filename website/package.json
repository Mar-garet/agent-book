{
  "name": "agent-book-reader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/content.mjs && vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "npm run check:markdown && node scripts/content.mjs && vite build",
    "check:markdown": "node scripts/check-markdown.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "playwright test",
    "previews": "node scripts/export-previews.mjs",
    "export:pdf": "node scripts/export-pdf.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "github-slugger": "^2.0.0",
    "mermaid": "^11.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.4"
  }
}
